<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 31 and above.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Crash and ANR reports belong to this device and are never backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="reports/" />
        <exclude domain="file" path="crash-pending/" />
        <exclude domain="sharedpref" path="crash_reports.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="reports/" />
        <exclude domain="file" path="crash-pending/" />
        <exclude domain="sharedpref" path="crash_reports.xml" />
    </device-transfer>
</data-extraction-rules>
