<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below.
   See https://developer.android.com/guide/topics/data/autobackup
   Crash and ANR reports belong to this device and are never backed up.
-->
<full-backup-content>
    <exclude domain="file" path="reports/" />
    <exclude domain="file" path="crash-pending/" />
    <exclude domain="sharedpref" path="crash_reports.xml" />
</full-backup-content>
